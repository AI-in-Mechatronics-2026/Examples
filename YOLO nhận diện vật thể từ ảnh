{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"private_outputs":true,"provenance":[{"file_id":"1wsehYf3ouQJgTCQ1miV2xz63LBtIIoi3","timestamp":1774495968892}],"authorship_tag":"ABX9TyO5Mv4r6D6SSn4/H8Cvu3Be"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","metadata":{"id":"d5b189d7"},"source":["!pip install ultralytics"],"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import warnings\n","warnings.filterwarnings('ignore')\n","\n","from ultralytics import YOLO\n","import cv2\n","import os\n","from google.colab import drive\n","\n","# Mount Google Drive\n","drive.mount('/content/drive')\n","\n","# 1. Khởi tạo mô hình\n","# 'yolov8n.pt' là bản Nano nhẹ, 'yolov8s.pt' sẽ chính xác hơn một chút\n","model = YOLO('yolov8n.pt')\n","\n","# 2. Đường dẫn tới file ảnh trong Google Drive\n","# Ví dụ: '/content/drive/MyDrive/folder_cua_ban/ten_file_anh.jpg'\n","image_path = '/content/drive/MyDrive/Colab Notebooks/Images/xemay (3).jpg'\n","\n","# Kiểm tra file có tồn tại không\n","if not os.path.exists(image_path):\n","    print(f\"Lỗi: Không tìm thấy file tại {image_path}. Vui lòng kiểm tra lại đường dẫn.\")\n","else:\n","    # 3. Chạy nhận diện\n","    results = model.predict(source=image_path, conf=0.25, classes=[3])\n","    # classes=[2] nghĩa là chỉ lọc riêng lớp 'car' (ô tô).\n","    # Thay đổi số trong ngoặc vuông để nhận diện các đối tượng khác. Ví dụ: [0] cho 'person', [3] cho 'motorcycle'.\n","    # Có thể tìm các ID lớp tại: https://github.com/ultralytics/ultralytics/blob/main/ultralytics/cfg/datasets/coco.yaml\n","\n","    moto_count = 0  # Khởi tạo biến đếm\n","    detection_details = [] # Khởi tạo danh sách để lưu trữ chi tiết nhận diện\n","\n","    # 4. Xử lý kết quả và Lưu ảnh\n","    for r in results:\n","        # Vẽ khung hình và nhãn lên ảnh\n","        res_plotted = r.plot()\n","\n","        # Lưu ảnh đã nhận diện xuống ổ đĩa\n","        output_path = 'result_moto.jpg' # Tên file để phản ánh đối tượng\n","        cv2.imwrite(output_path, res_plotted)\n","        print(f\"Đã lưu kết quả tại: {output_path}\")\n","\n","        # Lấy thông tin đối tượng và lưu vào danh sách\n","        for box in r.boxes:\n","            # Tọa độ: xmin, ymin, xmax, ymax\n","            coords = box.xyxy[0].tolist()\n","            # Độ tin cậy\n","            confidence = box.conf[0].item() # Lấy độ tin cậy\n","            # Định dạng tọa độ với 2 chữ số thập phân\n","            formatted_coords = [f'{c:.2f}' for c in coords]\n","            detection_details.append({'coords': formatted_coords, 'confidence': confidence}) # Lưu cả tọa độ và độ tin cậy\n","            moto_count += 1 # Tăng biến đếm\n","\n","    # Xem ảnh đã xử lý trong Colab:\n","    from IPython.display import Image, display\n","    display(Image(filename=output_path))\n","\n","    # In kết quả nhận diện theo định dạng mới\n","    print(f\"\\n- Tổng số đối tượng nhận diện được: {moto_count}\")\n","    for i, detail in enumerate(detection_details):\n","        print(f\"- Tìm thấy đối tượng thứ {i+1:02d} tại: {detail['coords']} (Xác suất: {detail['confidence']:.2f})\")\n"],"metadata":{"id":"RrMrcTiciAw0"},"execution_count":null,"outputs":[]}]}